pipeline {
      agent any

    stages {
        stage('Restore dependencies') {
            when{
                anyOf {
                    branch 'main'
                    branch 'develop'
                    
                }
            }
            steps {
                bat 'dotnet restore'
            }
        }
        stage('Build the Project') {
            when{
                anyOf {
                    branch 'main'
                    branch 'develop'
                    
                }
            }
            steps {
                bat 'dotnet build --no-restore'
            }
        }
            stage('Run Tests') {
                   when{
                anyOf {
                    branch 'main'
                    branch 'develop'
                    
                }
            }
            steps {
                bat 'dotnet test --no-build --verbosity normal'
            }
        }
    }
}
